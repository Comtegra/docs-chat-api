# docs-chat-api — lokalne środowisko (szablon)
# Skopiuj do .env i uzupełnij: cp .env.example .env  (.env jest w .gitignore — nigdy go nie commituj)
# `npm start` i `npm run db:migrate` wczytują .env automatycznie (--env-file-if-exists, node >= 22.9).
# Zmienna ustawiona już w środowisku (np. $env:FOO w PowerShell) ma pierwszeństwo nad plikiem.
# Konfiguracja = CZYSTY ENV (plan env-config-refactor); pełna lista z defaultami: lib/tenants/envConfig.mjs.

# Baza: lokalnie najprościej docker (patrz README, „Szybki start"):
#   docker run -d --name docs-chat-db -e POSTGRES_PASSWORD=dev -p 5433:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:dev@localhost:5433/postgres

# Gateway LLM (llmproxy). Bez klucza proces nie wstanie — konstruktor klienta jest fail-closed.
# Klucz: cgc api-keys create --level LLM. Do samych health-checków wystarczy "dummy".
OPENAI_BASE_URL=https://llm.comtegra.cloud/v1
OPENAI_API_KEY=dummy

# Klucz importu NIE jest env-em: serwis generuje go przy pierwszym boocie i pokazuje RAW
# raz w logu startu (cgc logs <name>); sha256 siedzi w bazie i przeżywa recreate.
# Rotacja/przejście na własny klucz: wygeneruj parę i ustaw:
# DOCS_CHAT_INDEX_KEYS=<sha256>

# Opcjonalne (defaulty w kodzie — lib/tenants/envConfig.mjs; user-facing w docs/install.md):
# DOCS_CHAT_LOCALES=pl                          # en | pl, lista po przecinku; pierwsza = default czatu
# DOCS_CHAT_MODEL=gemma-4-26b-a4b               # model czatu
# DOCS_CHAT_CORS_ORIGINS=*                      # np. https://docs.example.com (lista po przecinku)
# DOCS_CHAT_SITE_URL=                           # origin strony docs (absolutne linki źródeł)
# DOCS_CHAT_NAME=Docs Chat
# DOCS_CHAT_ORGANIZATION=
# DOCS_CHAT_PROMPT_FILE=/app/tenant/prompt.md   # brak pliku = tworzony z neutralnej bazy przy 1. boocie
# DOCS_CHAT_PERSONA_FILE=                       # opcjonalna persona (fail-closed)
# DOCS_CHAT_SITE_TOKENS=                        # sha256 tokena strony (przy DOCS_CHAT_AUTH_REQUIRE_SITE_TOKEN=true)
# DOCS_CHAT_LLM_API_KEY=                        # klucz LLM per-instancja (llm.requireOwnKey)
# DOCS_CHAT_LANGFUSE_BASE_URL=                  # observability (LANGFUSE_ENABLED=true)
# DOCS_CHAT_LANGFUSE_PUBLIC_KEY=
# DOCS_CHAT_LANGFUSE_SECRET_KEY=
# LANGFUSE_ENABLED=false

# Embeddingi (defaulty kodu = wartości produkcyjne; nadpisujesz tylko, gdy inne)
# EMBEDDING_MODEL=qwen3-embedding-8b
# EMBEDDING_VECTOR_SIZE=4096
# EMBEDDING_QUERY_INSTRUCTION=Given a question about product documentation, retrieve passages that answer it
